# Compiled binary (root or built inside the package dir)
/juice
/cmd/juice/juice

# Runtime config (generated with defaults on first run)
config.json

# SQLite database files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Auth tokens stored by the CLI
~/.juice/

# Environment / secrets
.env
*.env
.env.*

# Generated snapshot (reconstructed by snapshot.sh)
/snapshot.go.txt

# Scratch / archive
/.old/

# agent.py synthesized-action output (generated TinyGo source + WASM artifacts)
/.agent_build/

# Claude Code
.claude/

# Editor and OS clutter
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Test output and coverage
*.out
coverage.html
